<UserControl
    x:Class="v2rayN.Desktop.Views.PresetField"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="460"
    x:DataType="vms:PresetFieldViewModel"
    mc:Ignorable="d">
    <!--  PattN: a text field with an arrow that lists ready-made values, and the name of the one it holds under it (design 3.3);  -->
    <!--  without its text (ShowsText), the name sits beside the arrow  -->
    <UserControl.Styles>
        <!--  The arrow greys out with the field: the app's PathIcon style gives it a colour of its own, which a disabled button keeps  -->
        <Style Selector="Button:disabled PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultDisabledForeground}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
        <TextBox
            x:Name="txtValue"
            Grid.Row="0"
            Grid.Column="0"
            Width="400"
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Left"
            VerticalAlignment="Center" />
        <Button
            x:Name="btnChoose"
            Grid.Row="0"
            Grid.Column="1"
            Margin="{StaticResource MarginLr4}"
            VerticalAlignment="Center"
            Classes="IconButton">
            <PathIcon Data="{StaticResource SemiIconChevronDown}" />
        </Button>
        <TextBlock
            x:Name="txtHeld"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="{StaticResource MarginLr8}"
            HorizontalAlignment="Left"
            IsVisible="False"
            Opacity="0.7" />
    </Grid>
</UserControl>
