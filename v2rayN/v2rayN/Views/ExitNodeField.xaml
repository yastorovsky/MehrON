<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ExitNodeField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="420"
    x:TypeArguments="vms:ExitNodeFieldViewModel"
    mc:Ignorable="d">
    <!--  PattN: the exit-node of an Aether core, freedom or a profile by its name, with what the name comes to under it (design 3.2.2 row 15)  -->
    <StackPanel>
        <ComboBox
            x:Name="cmbNode"
            Width="400"
            Margin="{StaticResource Margin4}"
            MaxDropDownHeight="1000"
            Style="{StaticResource DefComboBox}" />
        <TextBlock
            x:Name="txtSupporting"
            Width="400"
            Margin="{StaticResource MarginLeftRight8}"
            HorizontalAlignment="Left"
            Style="{StaticResource ToolbarTextBlock}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</reactiveui:ReactiveUserControl>
