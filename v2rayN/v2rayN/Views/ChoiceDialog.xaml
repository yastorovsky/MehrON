<Window
    x:Class="v2rayN.Views.ChoiceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="480"
    MinWidth="350"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--  PattN: a question with buttons of its own, such as the missing-keys question of the Aether editor (design 3.2.4)  -->
    <DockPanel Margin="{StaticResource Margin8}">
        <!--  The buttons wrap onto another line where they are wider than the window, as in a long translation; every line keeps to the right, as in the Avalonia twin  -->
        <base:RightWrapPanel
            x:Name="panelButtons"
            Margin="{StaticResource Margin4}"
            DockPanel.Dock="Bottom"
            LineSpacing="8" />
        <TextBlock
            x:Name="txtMessage"
            Margin="{StaticResource Margin8}"
            VerticalAlignment="Center"
            Style="{StaticResource ToolbarTextBlock}"
            TextWrapping="Wrap" />
    </DockPanel>
</Window>
