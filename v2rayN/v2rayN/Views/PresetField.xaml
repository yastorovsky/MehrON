<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.PresetField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignWidth="460"
    x:TypeArguments="vms:PresetFieldViewModel"
    mc:Ignorable="d">
    <!--  PattN: a text field with an arrow that lists ready-made values, and the name of the one it holds under it (design 3.3);  -->
    <!--  without its text (ShowsText), the name sits beside the arrow  -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="txtValue"
            Grid.Row="0"
            Grid.Column="0"
            Width="400"
            Margin="{StaticResource Margin4}"
            VerticalAlignment="Center"
            Style="{StaticResource DefTextBox}" />
        <Button
            x:Name="btnChoose"
            Grid.Row="0"
            Grid.Column="1"
            Margin="{StaticResource MarginLeftRight4}"
            VerticalAlignment="Center"
            Style="{StaticResource MaterialDesignToolButton}">
            <materialDesign:PackIcon Kind="ChevronDown" />
        </Button>
        <TextBlock
            x:Name="txtHeld"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="{StaticResource MarginLeftRight8}"
            HorizontalAlignment="Left"
            Opacity="0.7"
            Style="{StaticResource ToolbarTextBlock}"
            Visibility="Collapsed" />
    </Grid>
</reactiveui:ReactiveUserControl>
